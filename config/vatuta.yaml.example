rag:
  llm_backends:
    bedrock:
      model_id: "bedrock/us.anthropic.claude-3-7-sonnet-20250219-v1:0"
      # temperature: 0.2
      # max_tokens: 800
      # top_k: 4
    gemini:
      model_id: "gemini/gemini-3.7-flash"
      # temperature: 1.0
      # max_tokens: 800
      # top_k: 4

  router_backend: "gemini"
  generator_backend: "bedrock"

entities_manager:
  storage_path: "data/entities.json"

qdrant:
  url: "http://localhost:6333"
  collection_name: "vatuta_documents"
  # dense_vector_name: "dense"
  embeddings_model: "intfloat/multilingual-e5-small"
  embeddings_query_prefix: "query: "
  embeddings_document_prefix: "passage: "
  embeddings_normalize: true
  # sparse_vector_name: "sparse"
  sparse_embeddings_model: "Qdrant/bm25"

sources:
  slack:
    slack-main:
      enabled: true
      workspace_domain: "https://your-workspace.slack.com"
      channel_types:
        - "public_channel"
        - "private_channel"
        - "im"
        - "mpim"
      initial_lookback_days: 30
      channel_window_minutes: 60
      user_cache_path: "data/slack/slack-main/slack_users_cache.json"
      user_cache_ttl_seconds: 604800  # 7 days
      # Optional chunking parameters:
      # chunk_time_interval_minutes: 240   # max minutes gap between messages before splitting
      # chunk_max_size_chars: 2000         # max characters per chunk (capped by embedding model limit)
      # chunk_max_messages: 20             # max messages per chunk
      # chunk_similarity_threshold: 0.15   # cosine similarity threshold for semantic splitting
      chunk_embedding_model: "intfloat/multilingual-e5-small" # Used solely for semantic splitting, independent of Qdrant

  jira:
    jira-main:
      enabled: true
      url: "https://your-domain.atlassian.net"
      projects: ["PROJECT1", "PROJECT2"]
      # Optional chunking parameters:
      # chunk_max_size_chars: 2000         # max characters per comment chunk (capped by embedding model limit)
      # chunk_max_comments: 10             # max comments per comment chunk
      # chunk_similarity_threshold: 0.15   # cosine similarity threshold for semantic splitting
      chunk_embedding_model: "intfloat/multilingual-e5-small" # Used solely for semantic splitting, independent of Qdrant
      # history_chunk_size: 20             # max history entries per history chunk

  confluence:
    confluence-main:
      enabled: true
      url: "https://your-domain.atlassian.net"
      spaces: ["SPACE1"]
      initial_lookback_days: 30
      # chunk_max_size_chars: 1000         # max characters per content chunk

mcp_servers:
  everything:
    image: "mcp/everything"
    auto_pull: true
    allow_network: false
    read_only: true
    allowed_tools:
      - "^add$"
  wikipedia:
    image: "mcp/wikipedia-mcp"
    auto_pull: true
    allow_network: true
    read_only: true
    args:
      - "--language"
      - "es"
    allowed_tools:
      - "^search_wikipedia$"
      - "^get_summary$"
